{
  "name": "desktop",
  "version": "1.0.2",
  "description": "Ultra-fast local file sharing",
  "repository": {
    "type": "git",
    "url": "https://github.com/mani5h-agarwal/SwiftShareX.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:app": "npm run build && electron-builder",
    "start": "electron ."
  },
  "build": {
    "appId": "com.swiftshare.desktop",
    "productName": "SwiftShareX",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "files": [
      "package.json",
      "dist/**/*",
      "dist-electron/**/*",
      "icon.png"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@react-native-community/blur": "^4.4.1",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@react-navigation/stack": "^7.8.9",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-native-gesture-handler": "^2.30.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-require-transform": "^1.0.21"
  }
}
